# Application
NODE_ENV=production
PORT=3000
API_PORT=3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=itsm_platform
DB_USER=itsm_user
DB_PASSWORD=changeme

# Redis
